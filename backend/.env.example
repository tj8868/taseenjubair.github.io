# Copy to  .env  and change every value before running anywhere but localhost.

# Signs the admin session cookie. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Seeded on first run only. Change the password from the admin panel afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Where the SQLite file lives, relative to the backend/ directory.
DATABASE_URL=sqlite:///./portfolio.db

# Origins allowed to call the public API from a browser.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
