---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getSite } from "../lib/cms";
import { url } from "../lib/url";

const { profile } = await getSite();
const cvPdfUrl = url(profile.resume || "assets/cv.pdf");
const description = `Curriculum vitae of ${profile.name}: Public Health & AI Researcher.`;

// Pre-rendered high-resolution pages (180 DPI crisp text)
// Guaranteed 100% browser compatibility across all browsers, mobile devices, and ad blockers
const pages = [
  url("assets/cv-page-1.png"),
  url("assets/cv-page-2.png"),
  url("assets/cv-page-3.png"),
  url("assets/cv-page-4.png"),
];
---

<BaseLayout title="CV" description={description}>
  <section class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <div>
      <p class="eyebrow">Curriculum vitae</p>
      <h2
        class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--fg-strong)]"
      >
        Curriculum Vitae
      </h2>
    </div>

    <div class="no-print flex items-center gap-3">
      <a
        href={cvPdfUrl}
        download="HM_Taseen_Jubair_Bhuiyan_CV.pdf"
        class="btn-primary"
      >
        <Icon name="download" size={15} />
        Download CV
      </a>
      <a
        href={cvPdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        Open PDF
      </a>
    </div>
  </section>

  <!-- Seamless Document Reader (Zero plugin dependency, zero iframe blocks) -->
  <div class="w-full flex flex-col items-center gap-6">
    {
      pages.map((pageSrc, idx) => (
        <article class="w-full max-w-4xl rounded-xl overflow-hidden border border-[var(--border)] bg-white shadow-2xl transition-transform">
          <header class="sr-only">
            <h3>Page {idx + 1}</h3>
          </header>
          <img
            src={pageSrc}
            alt={`Curriculum Vitae page ${idx + 1} - H.M. Taseen Jubair Bhuiyan`}
            loading={idx === 0 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-auto block"
          />
        </article>
      ))
    }
  </div>

  <div class="mt-8 mb-4 text-center no-print">
    <a
      href={cvPdfUrl}
      download="HM_Taseen_Jubair_Bhuiyan_CV.pdf"
      class="btn-primary inline-flex"
    >
      <Icon name="download" size={15} />
      Download Complete CV (PDF)
    </a>
  </div>
</BaseLayout>
