---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getSite } from "../lib/cms";
import { url } from "../lib/url";

const { profile } = await getSite();
const rawPdfPath = profile.resume || "assets/cv.pdf";
const cvPdfUrl = url(rawPdfPath);
// Viewer URL exactly like cs.harvard.edu/malan/cv/
const viewerUrl = url(`vendor/pdfjs/web/viewer.html?file=${encodeURIComponent(cvPdfUrl)}#pagemode=none`);
const description = `Curriculum vitae of ${profile.name}: Public Health & AI Researcher.`;
---

<BaseLayout title="CV" description={description}>
  <section class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <p class="eyebrow">Curriculum vitae</p>
      <h2
        class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--fg-strong)]"
      >
        Curriculum Vitae
      </h2>
    </div>

    <div class="no-print flex items-center gap-3">
      <a
        href={cvPdfUrl}
        download="HM_Taseen_Jubair_Bhuiyan_CV.pdf"
        class="btn-primary"
      >
        <Icon name="download" size={15} />
        Download CV
      </a>
      <a
        href={cvPdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        Open in new tab
      </a>
    </div>
  </section>

  <!-- Interactive PDF Viewport (Same engine & architecture as cs.harvard.edu/malan/cv) -->
  <div class="w-full rounded-xl overflow-hidden border border-[var(--border)] bg-[var(--surface-solid)] shadow-xl">
    <iframe
      src={viewerUrl}
      class="w-full h-[85vh] min-h-[650px] border-0 rounded-xl"
      title="Curriculum Vitae PDF Viewer"
      loading="lazy"
    >
      <p class="p-8 text-center text-[var(--muted)]">
        Your browser does not support iframes. 
        <a href={cvPdfUrl} class="link-underline font-medium text-[var(--accent)] ml-1">
          Click here to view or download the CV
        </a>.
      </p>
    </iframe>
  </div>
</BaseLayout>
