---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getSite } from "../lib/cms";
import { url } from "../lib/url";

const { profile } = await getSite();
const cvPdfUrl = url(profile.resume || "assets/cv.pdf");
const description = `Curriculum vitae of ${profile.name}: Public Health & AI Researcher.`;
---

<BaseLayout title="CV" description={description}>
  <section class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <p class="eyebrow">Curriculum vitae</p>
      <h2
        class="mt-1 text-2xl sm:text-3xl font-semibold tracking-tight text-[var(--fg-strong)]"
      >
        Curriculum Vitae
      </h2>
    </div>

    <div class="no-print flex items-center gap-3">
      <a
        href={cvPdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        <Icon name="download" size={15} />
        Download CV
      </a>
      <a
        href={cvPdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        Open in new tab
      </a>
    </div>
  </section>

  <!-- Embedded PDF Viewer matching David J. Malan's /cv/ layout -->
  <div class="w-full rounded-xl overflow-hidden border border-[var(--border)] bg-[var(--surface-solid)] shadow-lg">
    <iframe
      src={`${cvPdfUrl}#view=FitH`}
      class="w-full h-[85vh] min-h-[750px] border-none block"
      title="Curriculum Vitae"
    >
      <p class="p-8 text-center text-[var(--muted)]">
        Your browser does not support inline PDFs. 
        <a href={cvPdfUrl} class="link-underline font-medium text-[var(--accent)] ml-1">
          Click here to view or download the CV.
        </a>
      </p>
    </iframe>
  </div>
</BaseLayout>
